# CTI-Toolbox Environment Variables Configuration Template
# Copy this file to .env and insert your API keys

# AlienVault OTX (https://otx.alienvault.com/api/)
OTX_AUTHKEY=

# IBM X-Force Exchange (Basic auth base64 or API Key)
XFEX_CRED=

# VirusTotal API Key (https://www.virustotal.com/)
VT_KEY=

# Google SafeBrowsing API Key (https://console.developers.google.com/)
GO_KEY=

# PacketMail API Key (https://www.packetmail.net/)
PACKETMAIL_KEY=
SLOWCOOK_APIKEY=

# MISP Instance Configuration
MISP_URL=http://127.0.0.1:8080
MISP_AUTHKEY=

# Local Server Settings
LOCAL_LINK=http://127.0.0.1:5010
LOCAL_PORT=5010
